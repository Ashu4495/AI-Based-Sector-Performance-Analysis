{
  "name": "marketpulseai-deployment",
  "version": "1.0.0",
  "description": "Root package.json for easy frontend deployment on Render/Railway",
  "scripts": {
    "install-frontend": "cd frontend && npm install",
    "build": "cd frontend && npm install && npm run build",
    "start": "cd frontend && npm run preview",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": ".venv\\Scripts\\uvicorn backend.app.main:app --port 8000 --reload"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
